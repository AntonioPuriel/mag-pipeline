// Marine Honour case study (PRJNA1263040) on the Pyrene cluster
// mag-pipeline v1.6.1 (updated for v2.0.0): trimmed reads (--skip_fastp), mapping without persistent BAMs,
// dereplication of the MAGs of all co-assemblies with galah
//
// Use together with the pyrene profile:
//   nextflow run <pipeline> -profile pyrene -c marine_honour.config -resume
//
// Where each step runs, and why:
//   bigmem   MEGAHIT (here), GTDB-Tk and eggNOG-mapper (conf/pyrene.config)
//            need a lot of memory and must not be interrupted. The QOS allows
//            128 cores per user, but the limit for MEGAHIT is disk, not cores:
//            it runs 2 at a time (maxForks). With --workflow both, CAT and the
//            eggNOG of the gene catalog also go to bigmem (conf/pyrene.config).
//   standard Long steps that should not be interrupted (CONCOCT, DAS_Tool,
//            CheckM2). Under 64 GB per job, at most 2000 MB per core; 64 cores
//            per user, 2 of them taken by the main Nextflow job.
//   free     Everything else (the 384 alignments with their depths, merges,
//            MetaBAT2, Prodigal, summaries). 96 cores per user, no preemption.

params {
    // one representative per species-level cluster (95% ANI) across the 8 co-assemblies
    dereplicate       = true

    // reads were trimmed in a previous run (fastp_only.nf) and moved to data/trimmed
    input             = '/path/to/data/samplesheet_trimmed.csv'
    skip_fastp        = true
    outdir            = '/path/to/data/results_marine_honour'

    // one co-assembly per sampling time, every sample mapped against every one
    assembly_mode     = 'group'
    map_all_samples   = true

    // 12 x 8 cores fill the free QOS; each running task holds one temporary BAM
    max_mapping_jobs  = 12

    binners           = 'concoct,metabat2'
    refine            = true
    min_contig_length = 1500

    // Taxonomy and annotation are added later with -resume, on the
    // dereplicated MAGs:
    //   --gtdbtk_db /softs/contrib/apps/anaconda/3/envs/gtdbtk-2.7.2/share/gtdbtk-2.7.2/db
    //   --eggnog_db /softs/contrib/apps/anaconda/3/envs/eggnog-mapper-2.1.13/databases
    eggnog_dbmem      = true

    // v2.0.0: de novo tree of the 281 representatives, the contig branch and
    // SingleM, added with -resume once the MAG run has finished. Every MAG
    // step stays cached, GTDB-Tk included (its new outputs come from its
    // finished task).
    //   mag_tree          = true
    //   workflow          = 'both'
    //   cat_db            = '/work/aphernand001/dbs/cat_gtdb'
    //   singlem_db        = '/work/aphernand001/dbs/singlem'
    // DIAMOND inside CAT with less memory than its defaults (12, 1)
    cat_block_size    = 4
    cat_index_chunks  = 4
}

executor {
    name            = 'slurm'
    queueSize       = 100          // jobs in the queue at the same time
    submitRateLimit = '20 min'     // do not flood the scheduler
    pollInterval    = '1 min'
}

process {
    executor = 'slurm'

    // Default: free. Failed steps are retried up to 3 times.
    queue          = 'free'
    clusterOptions = '--account=free'
    errorStrategy  = { task.attempt <= 3 ? 'retry' : 'finish' }
    maxRetries     = 3

    withName: 'FASTP' {
        cpus           = 8
        memory         = '16 GB'
        time           = '6h'
    }

    // Only 2 assemblies at a time: each one holds 180-250 GB of k-mer graphs
    // until it finishes. 8 at once filled the 1 TB quota on /work, and 3 at once
    // left less than 200 GB free. With 16 cores one co-assembly took ~4 days
    // (k=21 alone 37-43 h), so each gets 32 cores: 2 x 32 = 64 of the 128 cores
    // bigmem allows per user. The time limit is the bigmem maximum (5 days).
    // T0 and T1 were assembled with 16 cores: the module passes task.cpus to
    // MEGAHIT, so they keep 16 or -resume would treat them as new tasks and
    // redo them and their 96 alignments.
    withName: 'MEGAHIT' {
        queue          = 'bigmem'
        clusterOptions = '--account=bigmem'
        cpus           = { id in ['T0', 'T1'] ? 16 : 32 }
        memory         = '300 GB'
        time           = '5d'
        maxRetries     = 1
        maxForks       = 2
    }

    withName: 'FILTER_CONTIGS|CONCOCT_CUTUP' {
        cpus   = 2
        memory = '8 GB'
        time   = '2h'
    }

    withName: 'BOWTIE2_BUILD' {
        cpus           = 8
        memory         = '32 GB'
        time           = '12h'
    }

    // Mapping + jgi depth + CONCOCT coverage of one sample, then the BAM is deleted
    withName: 'MAP_DEPTH' {
        cpus           = 8
        memory         = '24 GB'
        time           = '12h'
    }

    withName: 'MERGE_DEPTHS|MERGE_CONCOCT_COV' {
        cpus   = 1
        memory = '8 GB'
        time   = '6h'
    }

    withName: 'METABAT2' {
        cpus           = 8
        memory         = '32 GB'
        time           = '12h'
    }

    // Long steps: on standard, which never preempts.
    //
    // GTDB_TK and EGGNOG_MAPPER are NOT listed here: conf/pyrene.config sends
    // them to bigmem. When several withName blocks match a process, the one
    // that sits lower in the merged configuration wins, and this file is read
    // after the profile. A regex here that matches EGGNOG_MAPPER sent eggNOG to
    // standard and made it run out of memory; writing the bigmem block again
    // below the regex does not help, because a selector repeated in a later
    // file keeps the place where it first appeared. Keep these regexes to
    // processes the profile does not configure.
    withName: 'CONCOCT|DAS_TOOL|CHECKM2' {
        queue          = 'standard'
        clusterOptions = '--account=uppa'
        cpus           = 16
        memory         = '64 GB'
        time           = '4d'
    }

    withName: 'PRODIGAL' {
        cpus   = 4
        memory = '8 GB'
        time   = '6h'
    }

    // ---- v2.0.0: contig branch and SingleM ----
    // Queue, cores and memory of GENE_CATALOG, GENE_ABUNDANCE, CONTIG_PROFILES,
    // EGGNOG_GENES and CAT_CONTIGS come from conf/pyrene.config. Here only what
    // is specific to this dataset. First guesses for 8 co-assemblies of 48
    // samples: check the trace of the first run and adjust.

    withName: 'PRODIGAL_CONTIGS' {
        cpus   = 16
        memory = '16 GB'
        time   = '12h'
    }

    // At most 2 bigmem jobs each for the catalog annotation and CAT, next to
    // GTDB-Tk: 2 x 16 + 2 x 32 + 16 cores, within the 128 bigmem allows per user
    withName: 'EGGNOG_GENES|CAT_CONTIGS' {
        maxForks = 2
    }

    withName: 'CANTHYD_GENES|HADEG_GENES' {
        queue          = 'standard'
        clusterOptions = '--account=uppa'
        cpus           = 8
        memory         = '16 GB'
        time           = '12h'
    }

    // SingleM runs one DIAMOND per thread (half the cores): 16 cores and
    // 31 GB, the most standard allows (2000 MB per core). With 8 cores and
    // 16 GB every sample ran out of memory. Two at a time, so that
    // PRODIGAL_CONTIGS and MAG_TREE also fit in the 64 cores of standard
    withName: 'SINGLEM' {
        queue          = 'standard'
        clusterOptions = '--account=uppa'
        cpus           = 16
        memory         = '31 GB'
        time           = '24h'
        maxForks       = 2
    }

    // Only trivial steps run inside the main Nextflow job: there the local
    // executor sees 2 GB, and long tasks fail with "process hasn't exited"
    // (BIN_SUMMARY took 2 h). Everything else, including BIN_SUMMARY,
    // MAG_ABUNDANCE and SPLIT_CATALOG, goes to SLURM (free).
    withName: 'MAPPING_SUMMARY|MAG_QUALITY|FUNCTIONAL_SUMMARY' {
        executor = 'local'
        cpus     = 1
        memory   = '4 GB'
    }
}
