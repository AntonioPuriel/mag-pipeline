process {
    cpus   = 1
    memory = '4 GB'
    time   = '2h'

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4 GB'
        time   = '2h'
    }
    withLabel: 'process_medium' {
        cpus   = 8
        memory = '16 GB'
        time   = '8h'
    }
    withLabel: 'process_high' {
        cpus   = 32
        memory = '128 GB'
        time   = '48h'
    }
}
