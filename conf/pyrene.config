// Pyrene cluster (UPPA): use the pre-installed conda environments
// Before running: module load bioconda-tools/3
// CONCOCT is not installed on Pyrene: create it once with
//   conda create -p ~/envs/concoct -c conda-forge -c bioconda concoct=1.1.0 samtools -y
// galah (--dereplicate) is not installed either:
//   conda create -p ~/envs/galah -c conda-forge -c bioconda galah=0.5.2 -y
// The conda package brings fastANI and skani, which galah 0.5.2 calls as
// external programs. With the static galah binary from GitHub instead, install
// them apart and put them in the PATH of the GALAH task:
//   micromamba create -p ~/envs/galah_deps -c conda-forge -c bioconda fastani=1.34 skani=0.4.0 -y
//   process { withName: 'GALAH' { beforeScript = 'export PATH=$HOME/envs/galah_deps/bin:$PATH' } }
// GUNC (--gunc_db) neither, nor its database. Create the environment with
// micromamba (conda runs out of memory on the login node):
//   micromamba create -p ~/envs/gunc -c conda-forge -c bioconda gunc=1.0.6 -y
//   ~/envs/gunc/bin/gunc download_db /path/to/gunc_db
// barrnap and tRNAscan-SE (--mimag), also with micromamba. The barrnap
// environment carries Python too, for the MIMAG table:
//   micromamba create -p ~/envs/barrnap  -c conda-forge -c bioconda barrnap=0.9 python=3.12 -y
//   micromamba create -p ~/envs/trnascan -c conda-forge -c bioconda trnascan-se=2.0.12 -y
// HMMER and DIAMOND for the hydrocarbon databases (--canthyd_db, --hadeg_db):
//   micromamba create -p ~/envs/hydrocarbon -c conda-forge -c bioconda hmmer=3.4 diamond=2.1.10 -y
// and the databases themselves, cloned from GitHub:
//   git clone https://github.com/dgittins/CANT-HYD-HydrocarbonBiodegradation.git
//     (--canthyd_db: 'HMMs/concatenated HMMs/CANT-HYD.hmm', copied to a path without spaces)
//   git clone https://github.com/jarojasva/HADEG.git   (--hadeg_db: the cloned directory)
//
// Contig branch (--workflow contigs or both) and SingleM, also with micromamba:
//   micromamba create -p ~/envs/genecat -c conda-forge -c bioconda mmseqs2=18.8cc5c python=3.12 numpy pandas -y
//   micromamba create -p ~/envs/cat     -c conda-forge -c bioconda cat=6.0.1 -y
//   micromamba create -p ~/envs/singlem -c conda-forge -c bioconda singlem=0.21.3 -y
// and their databases (both need internet: run them as jobs, not on the login node):
//   ~/envs/cat/bin/CAT_pack download --db GTDB -o /path/to/cat_gtdb_raw --cleanup
//   ~/envs/cat/bin/CAT_pack prepare --db_fasta /path/to/cat_gtdb_raw/gtdb_seqs.fa.gz \
//       --names /path/to/cat_gtdb_raw/names.dmp --nodes /path/to/cat_gtdb_raw/nodes.dmp \
//       --acc2tax /path/to/cat_gtdb_raw/prot.accession2taxid.txt.gz --db_dir /path/to/cat_gtdb
//     (--cat_db: /path/to/cat_gtdb, with db/ and tax/ inside)
//   ~/envs/singlem/bin/singlem data --output-directory /path/to/singlem_db   (--singlem_db)

conda.enabled = true

params {
    checkm2_db = '/softs/contrib/apps/anaconda/3/envs/checkm2-1.0.1/databases/CheckM2_database/uniref100.KO.1.dmnd'
    // Taxonomy is off by default because GTDB-Tk is slow and needs a large-memory node.
    // Enable it with:
    //   --gtdbtk_db /softs/contrib/apps/anaconda/3/envs/gtdbtk-2.7.2/share/gtdbtk-2.7.2/db
    // Functional annotation is off by default too. Enable it with:
    //   --eggnog_db /softs/contrib/apps/anaconda/3/envs/eggnog-mapper-2.1.13/databases
}

process {
    withName: 'FASTP' {
        conda = '/softs/contrib/apps/anaconda/3/envs/fastp-0.23.4'
    }
    withName: 'MEGAHIT' {
        conda = '/softs/contrib/apps/anaconda/3/envs/megahit-1.2.9'
    }
    withName: 'BOWTIE2_BUILD' {
        conda        = '/softs/contrib/apps/anaconda/3/envs/bowtie2-2.5.1'
        beforeScript = 'export PATH=/softs/contrib/apps/anaconda/3/envs/samtools-1.17/bin:$PATH'
    }
    // MAP_DEPTH needs bowtie2, samtools and jgi_summarize_bam_contig_depths in one task
    withName: 'MAP_DEPTH' {
        conda        = '/softs/contrib/apps/anaconda/3/envs/bowtie2-2.5.1'
        beforeScript = 'export PATH=/softs/contrib/apps/anaconda/3/envs/samtools-1.17/bin:/softs/contrib/apps/anaconda/3/envs/metabat2-2.18/bin:$PATH'
    }
    withName: 'METABAT2' {
        conda = '/softs/contrib/apps/anaconda/3/envs/metabat2-2.18'
    }
    withName: 'CONCOCT|CONCOCT_CUTUP' {
        conda = "${System.getenv('HOME')}/envs/concoct"
    }
    withName: 'DAS_TOOL' {
        conda = '/softs/contrib/apps/anaconda/3/envs/das_tool-1.1.7'
    }
    withName: 'CHECKM2' {
        conda = '/softs/contrib/apps/anaconda/3/envs/checkm2-1.0.1'
    }
    withName: 'GALAH' {
        conda = "${System.getenv('HOME')}/envs/galah"
    }
    withName: 'GUNC' {
        conda = "${System.getenv('HOME')}/envs/gunc"
    }
    withName: 'BARRNAP|MIMAG_QUALITY' {
        conda = "${System.getenv('HOME')}/envs/barrnap"
    }
    withName: 'TRNASCAN' {
        conda = "${System.getenv('HOME')}/envs/trnascan"
    }
    withName: 'CANTHYD|HADEG' {
        conda = "${System.getenv('HOME')}/envs/hydrocarbon"
    }
    // GTDB-Tk (pplacer) and eggNOG-mapper with --dbmem do not fit in the
    // standard partition (under 64 GB per job): they go straight to bigmem.
    // eggNOG ran out of memory four times with 64 GB on a 281-MAG catalogue.
    withName: 'GTDB_TK' {
        conda          = '/softs/contrib/apps/anaconda/3/envs/gtdbtk-2.7.2'
        queue          = 'bigmem'
        clusterOptions = '--account=bigmem'
        cpus           = 16
        memory         = 160.GB
        time           = '2d'
    }
    // De novo tree (--mag_tree): GTDB-Tk identify, align and FastTree, without
    // pplacer, so it fits in standard
    withName: 'MAG_TREE' {
        conda          = '/softs/contrib/apps/anaconda/3/envs/gtdbtk-2.7.2'
        queue          = 'standard'
        clusterOptions = '--account=uppa'
        cpus           = 16
        memory         = 32.GB
        time           = '12h'
    }
    withName: 'PRODIGAL' {
        conda = '/softs/contrib/apps/anaconda/3/envs/prodigal-2.6.3'
    }
    // eggNOG of the MAGs and of the gene catalog (--workflow contigs or both)
    withName: 'EGGNOG_MAPPER|EGGNOG_GENES' {
        conda          = '/softs/contrib/apps/anaconda/3/envs/eggnog-mapper-2.1.13'
        queue          = 'bigmem'
        clusterOptions = '--account=bigmem'
        cpus           = 16
        memory         = 160.GB
        time           = '3d'
    }

    // ---- Contig branch ----
    // standard (uppa) takes under 64 GB per job and at most 2000 MB per core;
    // anything larger goes to bigmem.
    withName: 'PRODIGAL_CONTIGS' {
        conda = '/softs/contrib/apps/anaconda/3/envs/prodigal-2.6.3'
    }
    // MMseqs2 linclust stays within 80 % of the task memory
    withName: 'GENE_CATALOG' {
        conda          = "${System.getenv('HOME')}/envs/genecat"
        queue          = 'standard'
        clusterOptions = '--account=uppa'
        cpus           = 30
        memory         = 60.GB
        time           = '2d'
    }
    // One genes x samples matrix in memory: tens of millions of genes
    // in a large co-assembly study
    withName: 'GENE_ABUNDANCE|CONTIG_PROFILES' {
        conda          = "${System.getenv('HOME')}/envs/genecat"
        queue          = 'bigmem'
        clusterOptions = '--account=bigmem'
        cpus           = 4
        memory         = 128.GB
        time           = '12h'
    }
    withName: 'CANTHYD_GENES|HADEG_GENES' {
        conda = "${System.getenv('HOME')}/envs/hydrocarbon"
    }
    // DIAMOND against the GTDB proteins
    withName: 'CAT_CONTIGS' {
        conda          = "${System.getenv('HOME')}/envs/cat"
        queue          = 'bigmem'
        clusterOptions = '--account=bigmem'
        cpus           = 32
        memory         = 160.GB
        time           = '3d'
    }
    withName: 'SINGLEM|SINGLEM_SUMMARY' {
        conda = "${System.getenv('HOME')}/envs/singlem"
    }
}
