// Pyrene cluster (UPPA): use the pre-installed conda environments
// Before running: module load bioconda-tools/3
// CONCOCT is not installed on Pyrene: create it once with
//   conda create -p ~/envs/concoct -c conda-forge -c bioconda concoct=1.1.0 samtools -y
// galah (--dereplicate) is not installed either:
//   conda create -p ~/envs/galah -c conda-forge -c bioconda galah=0.5.2 -y
// The conda package brings fastANI and skani, which galah 0.5.2 calls as
// external programs. With the static galah binary from GitHub instead, install
// them apart and put them in the PATH of the GALAH task:
//   micromamba create -p ~/envs/galah_deps -c conda-forge -c bioconda fastani=1.34 skani=0.4.0 -y
//   process { withName: 'GALAH' { beforeScript = 'export PATH=$HOME/envs/galah_deps/bin:$PATH' } }
// GUNC (--gunc_db) neither, nor its database. Create the environment with
// micromamba (conda runs out of memory on the login node):
//   micromamba create -p ~/envs/gunc -c conda-forge -c bioconda gunc=1.0.6 -y
//   ~/envs/gunc/bin/gunc download_db /path/to/gunc_db
// barrnap and tRNAscan-SE (--mimag), also with micromamba. The barrnap
// environment carries Python too, for the MIMAG table:
//   micromamba create -p ~/envs/barrnap  -c conda-forge -c bioconda barrnap=0.9 python=3.12 -y
//   micromamba create -p ~/envs/trnascan -c conda-forge -c bioconda trnascan-se=2.0.12 -y

conda.enabled = true

params {
    checkm2_db = '/softs/contrib/apps/anaconda/3/envs/checkm2-1.0.1/databases/CheckM2_database/uniref100.KO.1.dmnd'
    // Taxonomy is off by default because GTDB-Tk is slow and needs a large-memory node.
    // Enable it with:
    //   --gtdbtk_db /softs/contrib/apps/anaconda/3/envs/gtdbtk-2.7.2/share/gtdbtk-2.7.2/db
    // Functional annotation is off by default too. Enable it with:
    //   --eggnog_db /softs/contrib/apps/anaconda/3/envs/eggnog-mapper-2.1.13/databases
}

process {
    withName: 'FASTP' {
        conda = '/softs/contrib/apps/anaconda/3/envs/fastp-0.23.4'
    }
    withName: 'MEGAHIT' {
        conda = '/softs/contrib/apps/anaconda/3/envs/megahit-1.2.9'
    }
    withName: 'BOWTIE2_BUILD' {
        conda        = '/softs/contrib/apps/anaconda/3/envs/bowtie2-2.5.1'
        beforeScript = 'export PATH=/softs/contrib/apps/anaconda/3/envs/samtools-1.17/bin:$PATH'
    }
    // MAP_DEPTH needs bowtie2, samtools and jgi_summarize_bam_contig_depths in one task
    withName: 'MAP_DEPTH' {
        conda        = '/softs/contrib/apps/anaconda/3/envs/bowtie2-2.5.1'
        beforeScript = 'export PATH=/softs/contrib/apps/anaconda/3/envs/samtools-1.17/bin:/softs/contrib/apps/anaconda/3/envs/metabat2-2.18/bin:$PATH'
    }
    withName: 'METABAT2' {
        conda = '/softs/contrib/apps/anaconda/3/envs/metabat2-2.18'
    }
    withName: 'CONCOCT|CONCOCT_CUTUP' {
        conda = "${System.getenv('HOME')}/envs/concoct"
    }
    withName: 'DAS_TOOL' {
        conda = '/softs/contrib/apps/anaconda/3/envs/das_tool-1.1.7'
    }
    withName: 'CHECKM2' {
        conda = '/softs/contrib/apps/anaconda/3/envs/checkm2-1.0.1'
    }
    withName: 'GALAH' {
        conda = "${System.getenv('HOME')}/envs/galah"
    }
    withName: 'GUNC' {
        conda = "${System.getenv('HOME')}/envs/gunc"
    }
    withName: 'BARRNAP|MIMAG_QUALITY' {
        conda = "${System.getenv('HOME')}/envs/barrnap"
    }
    withName: 'TRNASCAN' {
        conda = "${System.getenv('HOME')}/envs/trnascan"
    }
    withName: 'GTDB_TK' {
        conda = '/softs/contrib/apps/anaconda/3/envs/gtdbtk-2.7.2'
    }
    withName: 'PRODIGAL' {
        conda = '/softs/contrib/apps/anaconda/3/envs/prodigal-2.6.3'
    }
    withName: 'EGGNOG_MAPPER' {
        conda = '/softs/contrib/apps/anaconda/3/envs/eggnog-mapper-2.1.13'
    }
}
