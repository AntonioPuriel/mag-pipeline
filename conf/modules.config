// Output folders of the processes reused under another name in the contig
// branch: the catalog annotations go to 08_contigs/function, apart from the
// annotations of the MAGs in 07_function.

process {
    withName: 'EGGNOG_GENES' {
        publishDir = [ path: "${params.outdir}/08_contigs/function", mode: 'copy', pattern: '*.emapper.annotations' ]
    }
    withName: 'CANTHYD_GENES|HADEG_GENES' {
        publishDir = [ path: "${params.outdir}/08_contigs/function", mode: 'copy' ]
    }
}
