manifest {
    name            = 'AntonioPuriel/mag-pipeline'
    author          = 'Antonio Puriel Hernández'
    description     = 'MAG recovery from paired-end shotgun metagenomes'
    nextflowVersion = '>=24.04.0'
    version         = '1.2.1'
}

params {
    input                   = null
    outdir                  = 'results'
    assembly_mode           = 'coassembly'         // 'coassembly' or 'per_sample'
    min_read_length         = 50
    min_contig_length       = 1500
    binners                 = 'concoct,metabat2'   // any of: concoct, metabat2
    refine                  = false                // combine bins with DAS_Tool
    dastool_score_threshold = 0.5
    checkm2_db              = null                 // path to uniref100.KO.1.dmnd
    skip_checkm2            = false
    gtdbtk_db               = null                 // GTDB-Tk reference data directory
    gtdbtk_pplacer_cpus     = 1                    // more threads multiply pplacer memory
    gtdbtk_args             = ''                   // extra flags for gtdbtk classify_wf
    eggnog_db               = null                 // eggNOG-mapper data directory
    eggnog_dbmem            = false                // load the database in RAM (needs ~45 GB)
    eggnog_args             = ''                   // extra flags for emapper.py
}

includeConfig 'conf/base.config'

profiles {
    test        { includeConfig 'conf/test.config' }
    docker      { docker.enabled = true }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm       { includeConfig 'conf/slurm.config' }
    pyrene      { includeConfig 'conf/pyrene.config' }
}

// Record what produced the results, so a run can be traced back later.
// The reference databases are dated by their own modification time.
workflow.onComplete = {
    def lines = [
        "mag-pipeline run information",
        "",
        "pipeline         : ${workflow.manifest.name} ${workflow.manifest.version}",
        "nextflow         : ${nextflow.version}",
        "started          : ${workflow.start}",
        "completed        : ${workflow.complete}",
        "duration         : ${workflow.duration}",
        "success          : ${workflow.success}",
        "profile          : ${workflow.profile}",
        "container engine : ${workflow.containerEngine ?: 'none (conda or local tools)'}",
        "work directory   : ${workflow.workDir}",
        "launch directory : ${workflow.launchDir}",
        "user             : ${workflow.userName}",
        "",
        "command line:",
        "  ${workflow.commandLine}",
        "",
        "reference databases:"
    ]

    [ 'CheckM2': params.checkm2_db, 'GTDB-Tk': params.gtdbtk_db, 'eggNOG': params.eggnog_db ].each { label, path ->
        if (!path) {
            lines << "  ${label.padRight(8)}: not used"
        }
        else {
            def f = new File(path.toString())
            def stamp = f.exists() ? new Date(f.lastModified()).format('yyyy-MM-dd') : 'unknown'
            lines << "  ${label.padRight(8)}: ${path} (last modified ${stamp})"
        }
    }

    lines << ""
    lines << "parameters:"
    params.sort { it.key }.each { key, value ->
        lines << "  ${key.padRight(24)}= ${value}"
    }

    def out = new File("${params.outdir}/run_info.txt")
    out.parentFile?.mkdirs()
    out.text = lines.join('\n') + '\n'
}
