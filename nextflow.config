manifest {
    name            = 'AntonioPuriel/mag-pipeline'
    author          = 'Antonio Puriel Hernández'
    description     = 'MAG recovery from paired-end shotgun metagenomes'
    nextflowVersion = '>=25.04.0'
    version         = '2.1.0'
}

params {
    input                   = null
    outdir                  = 'results'
    workflow                = 'mags'               // 'mags', 'contigs' (gene catalog, no binning) or 'both'
    assembly_mode           = 'coassembly'         // 'coassembly', 'group' or 'per_sample' (docs/assembly_strategies.md)
    map_all_samples         = false                // map every sample against every assembly
    max_mapping_jobs        = 8                    // MAP_DEPTH tasks at once: caps the space of temporary BAMs
    skip_fastp              = false                // samplesheet already points to trimmed reads
    min_read_length         = 50
    min_contig_length       = 1500
    binners                 = 'concoct,metabat2'   // any of: concoct, metabat2
    refine                  = false                // combine bins with DAS_Tool
    dastool_score_threshold = 0.5
    checkm2_db              = null                 // path to uniref100.KO.1.dmnd
    skip_checkm2            = false
    dereplicate             = false                // cluster MAGs of all assemblies with galah
    derep_ani               = 95                   // ANI (%) that defines a cluster (species level)
    derep_min_completeness  = 50                   // bins below this are left out of dereplication
    derep_max_contamination = 10                   // bins above this are left out of dereplication
    gunc_db                 = null                 // GUNC database (.dmnd from `gunc download_db`): enables the chimera check
    gunc_exclude            = false                // leave chimeric genomes out of dereplication
    mimag                   = false                // rRNA (barrnap) and tRNA (tRNAscan-SE) genes, and the MIMAG category of each genome
    gtdbtk_db               = null                 // GTDB-Tk reference data directory
    gtdbtk_pplacer_cpus     = 1                    // more threads multiply pplacer memory
    gtdbtk_args             = ''                   // extra flags for gtdbtk classify_wf
    mag_tree                = false                // de novo tree of the final genomes from the GTDB-Tk markers (needs --gtdbtk_db)
    eggnog_db               = null                 // eggNOG-mapper data directory
    eggnog_dbmem            = false                // load the database in RAM (needs ~45 GB)
    eggnog_args             = ''                   // extra flags for emapper.py
    canthyd_db              = null                 // CANT-HYD HMM file (CANT-HYD.hmm): hydrocarbon degradation marker genes
    hadeg_db                = null                 // HADEG repository directory: aerobic hydrocarbon degradation proteins and pathways
    hadeg_identity          = 50                   // minimum identity (%) of a HADEG hit, as recommended by the HADEG authors
    hadeg_coverage          = 70                   // minimum coverage (%) of both proteins in a HADEG hit
    // Contig branch (--workflow contigs or both)
    catalog_min_gene_length = 100                  // genes shorter than this (nt) are left out of the catalog
    catalog_min_id          = 0.95                 // identity that joins two genes in the catalog
    catalog_min_cov         = 0.9                  // fraction of each member covered by its representative
    catalog_chunk_size      = 1000000              // catalog proteins per eggNOG / CANT-HYD / HADEG job
    cat_db                  = null                 // CAT database folder (from `CAT_pack prepare`, with db/ and tax/): contig taxonomy
    cat_block_size          = 12                   // DIAMOND --block-size in CAT: lower uses less memory and disk
    cat_index_chunks        = 1                    // DIAMOND --index-chunks in CAT: higher uses less memory
    singlem_db              = null                 // SingleM metapackage folder (from `singlem data`): read-based profile of every sample
    email                   = null                 // send a summary by email when the run ends (needs `mail` on the head node)
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    test        { includeConfig 'conf/test.config' }
    docker      { docker.enabled = true }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    slurm       { includeConfig 'conf/slurm.config' }
    pyrene      { includeConfig 'conf/pyrene.config' }
}

// Record what produced the results, so a run can be traced back later.
// The reference databases are dated by their own modification time.
workflow.onComplete = {
    def lines = [
        "mag-pipeline run information",
        "",
        "pipeline         : ${workflow.manifest.name} ${workflow.manifest.version}",
        "nextflow         : ${nextflow.version}",
        "started          : ${workflow.start}",
        "completed        : ${workflow.complete}",
        "duration         : ${workflow.duration}",
        "success          : ${workflow.success}",
        "profile          : ${workflow.profile}",
        "container engine : ${workflow.containerEngine ?: 'none (conda or local tools)'}",
        "work directory   : ${workflow.workDir}",
        "launch directory : ${workflow.launchDir}",
        "user             : ${workflow.userName}",
        "",
        "command line:",
        "  ${workflow.commandLine}",
        "",
        "reference databases:"
    ]

    [ 'CheckM2': params.checkm2_db, 'GTDB-Tk': params.gtdbtk_db, 'eggNOG': params.eggnog_db,
      'CANT-HYD': params.canthyd_db, 'HADEG': params.hadeg_db, 'CAT': params.cat_db,
      'SingleM': params.singlem_db ].each { label, path ->
        if (!path) {
            lines << "  ${label.padRight(8)}: not used"
        }
        else {
            def f = new File(path.toString())
            def stamp = f.exists() ? new Date(f.lastModified()).format('yyyy-MM-dd') : 'unknown'
            lines << "  ${label.padRight(8)}: ${path} (last modified ${stamp})"
        }
    }

    lines << ""
    lines << "parameters:"
    params.sort { it.key }.each { key, value ->
        lines << "  ${key.padRight(24)}= ${value}"
    }

    def out = new File("${params.outdir}/run_info.txt")
    out.parentFile?.mkdirs()
    out.text = lines.join('\n') + '\n'

    // The same information as JSON, plus the tables the run produced, for
    // magreport::read_pipeline(). Table paths are relative to this file.
    // schema_version: minor up when a table or column is added, major up when
    // one is renamed or removed. A failure here must not hide run_info.txt.
    try {
        def plain = { v ->
            (v == null || v instanceof Boolean || v instanceof Number) ? v : v.toString()
        }
        def outdir = new File(params.outdir.toString()).absoluteFile

        // table name -> [folder under outdir, file name pattern]
        def known = [
            assembly_stats      : ['02_assembly',               /.+\.contigs\.stats\.tsv/],
            mapping_summary     : ['03_mapping',                /mapping_summary\.tsv/],
            depth               : ['03_mapping',                /.+\.depth\.txt/],
            bin_summary         : ['04_binning',                /bin_summary\.tsv/],
            contig2bin          : ['04_binning',                /contig2bin\.tsv/],
            mag_abundance       : ['04_binning',                /mag_abundance\.tsv(\.gz)?/],
            dastool_summary     : ['04_binning/dastool',        /.+_DASTool_summary\.tsv/],
            mag_quality         : ['05_quality',                /mag_quality\.tsv/],
            mimag_quality       : ['05_quality',                /mimag_quality\.tsv/],
            checkm2             : ['05_quality/checkm2',        /.+\.checkm2\.tsv/],
            gunc                : ['05_quality/gunc',           /.+\.gunc\.tsv/],
            dereplication       : ['05_quality/dereplication',  /dereplication_clusters\.tsv/],
            gtdbtk              : ['06_taxonomy',               /.+\.gtdbtk\.tsv/],
            mag_tree            : ['06_taxonomy/mag_tree',      /.+\.tree/],
            ko_per_mag          : ['07_function',               /ko_per_mag\.tsv/],
            annotation_stats    : ['07_function',               /annotation_stats\.tsv/],
            hydrocarbon_per_mag : ['07_function',               /hydrocarbon_per_mag\.tsv/],
            gene_catalog_stats  : ['08_contigs/catalog',        /gene_catalog\.stats\.tsv/],
            gene_abundance_stats: ['08_contigs/abundance',      /gene_abundance_stats\.tsv/],
            profile_stats       : ['08_contigs/profiles',       /profile_stats\.tsv/],
            taxonomy_per_sample : ['08_contigs/profiles',       /taxonomy_per_sample\.tsv(\.gz)?/],
            ko_per_sample       : ['08_contigs/profiles',       /ko_per_sample\.tsv(\.gz)?/],
            canthyd_per_sample  : ['08_contigs/profiles',       /canthyd_per_sample\.tsv(\.gz)?/],
            hadeg_per_sample    : ['08_contigs/profiles',       /hadeg_per_sample\.tsv(\.gz)?/],
            singlem             : ['09_singlem',                /singlem_profiles_with_extras\.tsv(\.gz)?/],
            singlem_per_sample  : ['09_singlem/profiles',       /.+\.singlem\.tsv(\.gz)?/],
            mag_tree_msa        : ['06_taxonomy/mag_tree',      /.+\.user_msa\.fasta(\.gz)?/]
        ]
        // table name -> [folder under outdir, pattern of the path below it]:
        // files in subfolders, such as gtdbtk/<set>/align/
        def nested = [
            gtdbtk_msa          : ['06_taxonomy/gtdbtk',        '[^/]+/align/[^/]+\\.user_msa\\.fasta(\\.gz)?'],
            gtdbtk_trees        : ['06_taxonomy/gtdbtk',        '[^/]+/classify/[^/]+\\.tree']
        ]
        def tables = [:]
        known.each { name, spec ->
            def dir = new File(outdir, spec[0])
            def hits = (dir.listFiles() ?: [])
                .findAll { f -> f.isFile() && f.name ==~ spec[1] }
                .collect { f -> "${spec[0]}/${f.name}".toString() }
                .sort()
            if (hits) {
                tables[name] = hits
            }
        }
        nested.each { name, spec ->
            def dir = new File(outdir, spec[0])
            def hits = []
            if (dir.isDirectory()) {
                def base = dir.toPath()
                dir.eachFileRecurse(groovy.io.FileType.FILES) { f ->
                    def rel = base.relativize(f.toPath()).toString().replace('\\', '/')
                    if (rel ==~ spec[1]) {
                        hits << "${spec[0]}/${rel}".toString()
                    }
                }
            }
            if (hits) {
                tables[name] = hits.sort()
            }
        }

        def databases = [:]
        [ checkm2: params.checkm2_db, gtdbtk: params.gtdbtk_db, eggnog: params.eggnog_db,
          canthyd: params.canthyd_db, hadeg: params.hadeg_db, cat: params.cat_db,
          singlem: params.singlem_db, gunc: params.gunc_db ].each { label, path ->
            if (path) {
                def f = new File(path.toString())
                databases[label] = [
                    path    : path.toString(),
                    modified: f.exists() ? new Date(f.lastModified()).format('yyyy-MM-dd') : null
                ]
            }
        }

        // Versions reported by the tools (main.nf, topic `versions`):
        // tool -> version; several versions of one tool are joined with ", "
        def software = [:]
        def versionsFile = new File(outdir, 'pipeline_info/software_versions.tsv')
        if (versionsFile.exists()) {
            def seen = [:]
            versionsFile.readLines().findAll { it.trim() }.each { line ->
                def fields = line.split('\t')
                if (fields.size() >= 3) {
                    if (!seen.containsKey(fields[1])) {
                        seen[fields[1]] = new LinkedHashSet()
                    }
                    seen[fields[1]] << fields[2]
                }
            }
            seen.sort { it.key }.each { tool, versions -> software[tool] = versions.join(', ') }
        }

        def manifest = [
            schema_version: '1.1',
            pipeline: [
                name    : plain.call(workflow.manifest.name),
                version : plain.call(workflow.manifest.version),
                revision: plain.call(workflow.revision),
                commit  : plain.call(workflow.commitId),
                nextflow: plain.call(nextflow.version)
            ],
            run: [
                name            : plain.call(workflow.runName),
                session_id      : plain.call(workflow.sessionId),
                started         : plain.call(workflow.start),
                completed       : plain.call(workflow.complete),
                duration        : plain.call(workflow.duration),
                success         : workflow.success,
                exit_status     : plain.call(workflow.exitStatus),
                profile         : plain.call(workflow.profile),
                container_engine: plain.call(workflow.containerEngine),
                command_line    : plain.call(workflow.commandLine)
            ],
            databases: databases,
            params   : params.sort { it.key }.collectEntries { k, v -> [(k.toString()): plain.call(v)] },
            software : software,
            tables   : tables
        ]

        def toJson = { m -> groovy.json.JsonOutput.prettyPrint(groovy.json.JsonOutput.toJson(m)) + '\n' }
        new File(outdir, 'manifest.json').text = toJson.call(manifest)

        // report/: the summary tables alone, compressed, to copy to a laptop
        // and read with magreport. Tables with one row per contig (depth,
        // contig2bin: GB in large runs) and the GTDB-Tk alignments and placement
        // trees (thousands of reference genomes) stay out; the report does not
        // use them. The alignment of --mag_tree goes in, to rebuild that tree.
        try {
            def excluded = ['depth', 'contig2bin', 'gtdbtk_msa', 'gtdbtk_trees']
            def report = new File(outdir, 'report')
            if (report.exists()) {
                report.deleteDir()   // rebuilt on every run, also with -resume
            }
            report.mkdirs()
            def bundled = [:]
            tables.findAll { name, files -> !(name in excluded) }.each { name, files ->
                bundled[name] = files.collect { rel ->
                    def src  = new File(outdir, rel)
                    def gzip = rel ==~ /.+\.(tsv|txt)/
                    def dest = new File(report, gzip ? "${rel}.gz" : rel)
                    dest.parentFile.mkdirs()
                    if (gzip) {
                        src.withInputStream { input ->
                            new java.util.zip.GZIPOutputStream(new java.io.FileOutputStream(dest)).withStream { output ->
                                output << input
                            }
                        }
                    }
                    else {
                        java.nio.file.Files.copy(src.toPath(), dest.toPath(),
                            java.nio.file.StandardCopyOption.REPLACE_EXISTING)
                    }
                    (gzip ? "${rel}.gz" : rel).toString()
                }
            }
            def info = new File(outdir, 'run_info.txt')
            if (info.exists()) {
                java.nio.file.Files.copy(info.toPath(), new File(report, 'run_info.txt').toPath(),
                    java.nio.file.StandardCopyOption.REPLACE_EXISTING)
            }
            def reportManifest = new LinkedHashMap(manifest)
            reportManifest.tables = bundled
            reportManifest.bundle = [
                excluded: excluded.findAll { tables.containsKey(it) }
            ]
            new File(report, 'manifest.json').text = toJson.call(reportManifest)
        }
        catch (Exception e) {
            System.err.println "mag-pipeline: could not write the report/ folder: ${e.message}"
        }
    }
    catch (Exception e) {
        System.err.println "mag-pipeline: could not write manifest.json: ${e.message}"
    }

    // Optional summary by email, sent with the system `mail` command
    if (params.email) {
        def status = workflow.success ? 'OK' : 'FAILED'
        def body = [
            "Status   : ${status}",
            "Exit     : ${workflow.exitStatus}",
            "Error    : ${workflow.errorMessage ?: '-'}",
            ""
        ]
        if (workflow.errorReport) {
            body << "Error report:"
            body << workflow.errorReport.toString()
            body << ""
        }
        body.addAll(lines)
        try {
            def cmd = ['mail', '-s', "mag-pipeline ${status}: ${workflow.runName}".toString(), params.email.toString()]
            def proc = cmd.execute()
            proc.withWriter { w -> w << body.collect { it.toString() }.join('\n') << '\n' }
            proc.waitFor()
            if (proc.exitValue() != 0) {
                System.err.println "mag-pipeline: could not send the email (mail exited with ${proc.exitValue()}): ${proc.err.text}"
            }
        }
        catch (Exception e) {
            System.err.println "mag-pipeline: could not send the email: ${e.message}"
        }
    }
}
